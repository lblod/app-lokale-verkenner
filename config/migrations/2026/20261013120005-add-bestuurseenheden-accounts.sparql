PREFIX besluit: <http://data.vlaanderen.be/ns/besluit#>
PREFIX mu: <http://mu.semte.ch/vocabularies/core/>
PREFIX ext: <http://mu.semte.ch/vocabularies/ext/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

INSERT {
  GRAPH <http://mu.semte.ch/graphs/public> {
    ?person a foaf:Person ;
      mu:uuid ?personUuid ;
      foaf:firstName ?classificationName ;
      foaf:familyName ?organizationName ;
      foaf:member ?organization ;
      foaf:account ?account .

    ?account a foaf:OnlineAccount ;
      mu:uuid ?accountUuid ;
      foaf:accountServiceHomepage <https://github.com/lblod/mock-login-service> ;
      ext:sessionRole "Gebruiker" .
  }
}
WHERE {
  GRAPH <http://mu.semte.ch/graphs/public> {
    ?organization a besluit:Bestuurseenheid, org:Organization ;
      mu:uuid ?organizationUuid ;
      skos:prefLabel ?organizationName ;
      org:classification ?classification .

    ?classification skos:prefLabel ?classificationName .
  }

  FILTER(LANG(?organizationName) = "" || LANGMATCHES(LANG(?organizationName), "nl"))
  FILTER(LANG(?classificationName) = "" || LANGMATCHES(LANG(?classificationName), "nl"))

  BIND(MD5(STR(?organization)) AS ?personUuid)
  BIND(MD5(CONCAT(STR(?organization), "mock-login-account")) AS ?accountUuid)
  BIND(IRI(CONCAT("http://data.lblod.info/id/persoon/", ?personUuid)) AS ?person)
  BIND(IRI(CONCAT("http://data.lblod.info/id/account/", ?accountUuid)) AS ?account)
};

INSERT {
  GRAPH ?organizationGraph {
    ?person a foaf:Person ;
      mu:uuid ?personUuid ;
      foaf:firstName ?classificationName ;
      foaf:familyName ?organizationName ;
      foaf:member ?organization ;
      foaf:account ?account .

    ?account a foaf:OnlineAccount ;
      mu:uuid ?accountUuid ;
      foaf:accountServiceHomepage <https://github.com/lblod/mock-login-service> ;
      ext:sessionRole "Gebruiker" .
  }
}
WHERE {
  GRAPH <http://mu.semte.ch/graphs/public> {
    ?organization a besluit:Bestuurseenheid, org:Organization ;
      mu:uuid ?organizationUuid ;
      skos:prefLabel ?organizationName ;
      org:classification ?classification .

    ?classification skos:prefLabel ?classificationName .
  }

  FILTER(LANG(?organizationName) = "" || LANGMATCHES(LANG(?organizationName), "nl"))
  FILTER(LANG(?classificationName) = "" || LANGMATCHES(LANG(?classificationName), "nl"))

  BIND(MD5(STR(?organization)) AS ?personUuid)
  BIND(MD5(CONCAT(STR(?organization), "mock-login-account")) AS ?accountUuid)
  BIND(IRI(CONCAT("http://data.lblod.info/id/persoon/", ?personUuid)) AS ?person)
  BIND(IRI(CONCAT("http://data.lblod.info/id/account/", ?accountUuid)) AS ?account)

  BIND(
    IRI(
      CONCAT(
        "http://mu.semte.ch/graphs/organizations/",
        STR(?organizationUuid)
      )
    )
    AS ?organizationGraph
  )
}