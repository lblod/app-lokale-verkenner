@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/> .
@prefix cr: <http://lblod.data.gift/vocabularies/change-requests/> .
@prefix scheme: <http://lblod.data.gift/concept-schemes/> .
@prefix concept: <http://lblod.data.gift/concepts/> .

# The two code lists of change-request-service: the status of a change request (adms:status of
# the request, and of each step: the status after it) and the type of a step (dct:type of a
# cr:Action). The service knows these URIs (constants.js); they are published here so the data
# describes itself. Labels without language tag, like the other code lists of this stack.

# --- Status van een wijzigingsaanvraag ----------------------------------------------------------

scheme:e8274055-0834-4511-8b84-a2af41055633
  rdf:type skos:ConceptScheme ;
  mu:uuid "e8274055-0834-4511-8b84-a2af41055633" ;
  skos:prefLabel "Status van een wijzigingsaanvraag" .

concept:d57aff85-43ce-4bd0-b962-6bd1b1fbc4b6
  rdf:type skos:Concept , cr:ChangeRequestStatus ;
  mu:uuid "d57aff85-43ce-4bd0-b962-6bd1b1fbc4b6" ;
  skos:prefLabel "Ingediend" ;
  skos:definition "De aanvraag is ingediend en wacht op een beslissing." ;
  skos:closeMatch <https://data.vlaanderen.be/id/concept/StatusVlaamseCode/Ingediend> ;
  skos:inScheme scheme:e8274055-0834-4511-8b84-a2af41055633 ;
  skos:topConceptOf scheme:e8274055-0834-4511-8b84-a2af41055633 .

concept:ca080d1f-f71c-4fe6-a4ed-a13fe1112989
  rdf:type skos:Concept , cr:ChangeRequestStatus ;
  mu:uuid "ca080d1f-f71c-4fe6-a4ed-a13fe1112989" ;
  skos:prefLabel "Goedgekeurd" ;
  skos:definition "De aanvraag is goedgekeurd en de wijziging is doorgevoerd." ;
  skos:closeMatch <https://data.vlaanderen.be/id/concept/StatusVlaamseCode/Goedgekeurd> ;
  skos:inScheme scheme:e8274055-0834-4511-8b84-a2af41055633 ;
  skos:topConceptOf scheme:e8274055-0834-4511-8b84-a2af41055633 .

concept:b53c0c43-aa7c-4eb4-b113-81a370c21014
  rdf:type skos:Concept , cr:ChangeRequestStatus ;
  mu:uuid "b53c0c43-aa7c-4eb4-b113-81a370c21014" ;
  skos:prefLabel "Afgekeurd" ;
  skos:definition "De aanvraag is afgekeurd; de wijziging is niet doorgevoerd." ;
  skos:inScheme scheme:e8274055-0834-4511-8b84-a2af41055633 ;
  skos:topConceptOf scheme:e8274055-0834-4511-8b84-a2af41055633 .

concept:3dd55ff1-c322-4660-819d-4641de440544
  rdf:type skos:Concept , cr:ChangeRequestStatus ;
  mu:uuid "3dd55ff1-c322-4660-819d-4641de440544" ;
  skos:prefLabel "Ingetrokken" ;
  skos:definition "De aanvraag is ingetrokken; de wijziging is niet doorgevoerd." ;
  skos:inScheme scheme:e8274055-0834-4511-8b84-a2af41055633 ;
  skos:topConceptOf scheme:e8274055-0834-4511-8b84-a2af41055633 .

concept:b610e2dc-902c-4874-b65e-78b7f6411c05
  rdf:type skos:Concept , cr:ChangeRequestStatus ;
  mu:uuid "b610e2dc-902c-4874-b65e-78b7f6411c05" ;
  skos:prefLabel "Mislukt" ;
  skos:definition "De aanvraag is goedgekeurd, maar het doorvoeren van de wijziging is mislukt." ;
  skos:inScheme scheme:e8274055-0834-4511-8b84-a2af41055633 ;
  skos:topConceptOf scheme:e8274055-0834-4511-8b84-a2af41055633 .

